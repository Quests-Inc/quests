[Unit]
Description=Quests STT sidecar (faster-whisper)
Documentation=file://%h/Quests/deploy/SERVER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change if the clone is not ~/Quests
WorkingDirectory=%h/Quests
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
# Overrides (defaults: small/cpu/int8/ru, bind 0.0.0.0:8766):
# Environment=QUESTS_WHISPER_MODEL=small
# Environment=QUESTS_STT_PORT=8766
ExecStart=/usr/bin/env uv run quests-stt
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
