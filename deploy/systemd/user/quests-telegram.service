[Unit]
Description=Quests Telegram bot
Documentation=file://%h/Quests/deploy/SERVER.md
After=network-online.target
Wants=network-online.target
# Same-host API (uncomment if quests-server runs under this user):
# After=network-online.target quests-server.service
# Wants=quests-server.service
# Same-host STT sidecar — needed for voice messages, not for text:
# After=network-online.target quests-stt.service
# Wants=quests-stt.service

[Service]
Type=simple
# Change if the clone is not ~/Quests
WorkingDirectory=%h/Quests
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
# Secrets: prefer project .env (loaded by envload). Optional overrides:
# Environment=QUESTS_TG_TOKEN=
# Environment=QUESTS_TG_USER_IDS=
# Environment=QUESTS_TG_PROXY=http://127.0.0.1:12334
# Environment=QUESTS_API=http://127.0.0.1:8765
ExecStart=/usr/bin/env uv run quests-telegram
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
