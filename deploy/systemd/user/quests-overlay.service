[Unit]
Description=Quests Wayland overlay (HUD + notices)
Documentation=file://%h/Quests/deploy/SERVER.md
PartOf=graphical-session.target
After=graphical-session.target
Wants=graphical-session.target
# Same-host API (optional):
# After=graphical-session.target quests-server.service
# Wants=quests-server.service

[Service]
Type=simple
WorkingDirectory=%h/Quests
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
# WAYLAND_DISPLAY / XDG_RUNTIME_DIR / NIRI_SOCKET: import into user manager
# (see deploy/systemd/README.md).
# Remote API (when server is not on this machine):
# Environment=QUESTS_API=http://api-host:8765
# Environment=QUESTS_WEB_URL=http://api-host:8765
# Go HUD: `just run-overlay` → go/bin/quests-overlay
ExecStart=/usr/bin/env just run-overlay
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
