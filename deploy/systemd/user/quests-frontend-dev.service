[Unit]
Description=Quests frontend Vite HMR (:5173)
Documentation=file://%h/Quests/deploy/SERVER.md
After=network-online.target quests-server.service
Wants=network-online.target quests-server.service

[Service]
Type=simple
WorkingDirectory=%h/Quests/frontend
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env npm run dev
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
