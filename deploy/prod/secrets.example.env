# Template for secrets.enc.env. Do NOT put real values here: copy it, fill it in and encrypt
# (`just secrets-init` does all three), then edit with `just secrets-edit`.

POSTGRES_PASSWORD=
# 32 random bytes, base64 (`openssl rand -base64 32`). Seals stored secrets and per-account LLM keys;
# without it sealed values cannot be opened, so keep a copy outside the database backups.
QUESTS_SECRET_KEY=

QUESTS_WEBDAV_PASS=
GROQ_API_KEY=

# Telegram bot (profile `bot`).
QUESTS_TG_TOKEN=
QUESTS_TG_USER_IDS=
# `quests-server token add telegram` inside the api container.
QUESTS_API_TOKEN=

# Monitoring.
QUESTS_METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Only if a template's mail script runs on a runner that reads this stack's env (it normally has its own secrets).
# MAIL_HOST=
# MAIL_USER=
# MAIL_PASSWORD=
