# Non-secret settings of the production stack (read as env_file by api, bot and stt, and for ${…}
# interpolation). Secrets go to secrets.enc.env. Values below are the documented defaults; uncomment to change.

# Accounts: auto = auth turns on as soon as an account exists.
# QUESTS_AUTH=auto
# Set to 1 when the instance is served over HTTPS (marks the session cookie Secure).
# QUESTS_SECURE_COOKIES=0
# QUESTS_TZ=Europe/Moscow

# Published ports.
# QUESTS_PUBLISH_PORT=8765
# QUESTS_HTTP_PORT=8080
# QUESTS_STT_PORT=8766

# Attachments (WebDAV + ClamAV). The WebDAV password is a secret.
# QUESTS_WEBDAV_URL=http://your-lan-host:8082
# QUESTS_WEBDAV_USER=quests
# QUESTS_MAX_UPLOAD_MB=25
# QUESTS_WORKSPACE_QUOTA_MB=2048

# LLM assistant (the key is a secret).
# QUESTS_LLM_PROVIDER=groq
# QUESTS_LLM_MODEL=openai/gpt-oss-20b
# QUESTS_LLM_PROXY=http://host.docker.internal:12334
# QUESTS_LLM_SHARED=0

# Backups (docs/postgres.md).
# QUESTS_BACKUP_INTERVAL_HOURS=24
# QUESTS_BACKUP_KEEP=14
# QUESTS_BACKUP_REMOTE_HOST=user@your-backup-host
# QUESTS_BACKUP_REMOTE_DIR=/home/user/QuestsBackups
# QUESTS_BACKUP_REMOTE_KEY=/app/data/backup_ssh_key

# Voice-to-text.
# QUESTS_WHISPER_MODEL=small
# QUESTS_WHISPER_LANGUAGE=ru

# Monitoring.
# KUMA_PORT=3001
# GRAFANA_PORT=3002
# GRAFANA_ROOT_URL=http://localhost:3000/
# PROMETHEUS_RETENTION=90d
