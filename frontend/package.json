{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test tests/unit && bun test --conditions browser --preload ./tests/components/setup.ts tests/components",
    "lint": "oxlint --quiet src tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "bun run lint && bun run format:check && bun run check && bun run check:any && bun run check:fsd && bun run check:arch && bun run test && bun run build",
    "check": "bun scripts/check-types.mjs",
    "check:any": "bun scripts/check-any.mjs",
    "check:fsd": "bun scripts/check-fsd.mjs",
    "check:arch": "bun scripts/check-arch.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "marked": "^18.0.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rolldown": "1.2.1",
    "svelte": "5.56.8",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9",
    "vite": "8.2.0"
  },
  "overrides": {
    "esrap": "2.3.0"
  }
}
